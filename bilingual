function t(key) {
  return (UI[key] && UI[key][LANG]) || key;
}

function applyLanguage(lang) {
  LANG = lang;
  onboardSteps = lang === 'ar' ? ONBOARD_AR : ONBOARD_EN;
  stocks = lang === 'ar' ? STOCKS_AR : STOCKS_EN;

  // document direction
  document.documentElement.lang = lang;
  document.documentElement.dir = lang === 'ar' ? 'rtl' : 'ltr';
  document.title = lang === 'ar' ? 'أثمار - استثمر بثقة' : 'Athmaar - Invest with Confidence';
  document.body.style.fontFamily = lang === 'ar' ? "'Tajawal', sans-serif" : "'Inter', sans-serif";

  // static text nodes — replace only the direct text, preserve child elements
  document.querySelectorAll('[data-i18n]').forEach(el => {
    const k = el.getAttribute('data-i18n');
    if (!I18N[k] || !I18N[k][lang]) return;
    const val = I18N[k][lang];
    // find first direct text child; if none, fall back to textContent
    let done = false;
    for (const node of el.childNodes) {
      if (node.nodeType === 3 && node.nodeValue.trim()) {
        node.nodeValue = val;
        done = true;
        break;
      }
    }
    if (!done && el.children.length === 0) el.textContent = val;
  });

  // toggle button label
  const tb = document.getElementById('lang-toggle');
  if (tb) tb.textContent = lang === 'ar' ? 'EN' : 'ع';

  // chat input placeholder
  const ci = document.getElementById('chat-input');
  if (ci) ci.placeholder = t('input_ph');

  // suggestion chips
  const sc = document.getElementById('suggestions');
  if (sc) {
    const labels = lang === 'ar'
      ? ['أداء المحفظة','الفحص الشرعي','شرح الصكوك','توصية الشهر','التطهير']
      : ['Portfolio Performance','Shariah Screening','What is Sukuk?','Monthly Recommendation','Purification'];
    sc.innerHTML = SUGG.map((s,i) =>
      `<button class="suggestion-chip" onclick="sendSuggestion(${JSON.stringify(JSON.stringify(s[lang])) })">${labels[i]}</button>`
    ).join('');
  }

  // reset chat to welcome message in current language
  const cm = document.getElementById('chat-messages');
  if (cm) cm.innerHTML = `<div class="msg msg-ai">${WELCOME[lang]}</div>`;

  // re-render dynamic views
  if (typeof renderStep === 'function') renderStep();
  if (typeof renderStocks === 'function') renderStocks(currentTab || 'all');
}

function toggleLang() {
  applyLanguage(LANG === 'ar' ? 'en' : 'ar');
}

