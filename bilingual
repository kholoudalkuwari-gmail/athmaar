<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>أثمار - استثمر بثقة</title>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;700;800&family=Tajawal:wght@300;400;500;700;800&display=swap" rel="stylesheet">
<style>
  :root {
    --navy: #0D2137;
    --teal: #02C39A;
    --teal2: #028090;
    --light: #F0FAFA;
    --white: #FFFFFF;
    --gray: #6B7280;
    --light-gray: #F3F4F6;
    --border: #E5E7EB;
    --red: #EF4444;
    --green: #10B981;
    --gold: #F59E0B;
  }

  * { margin: 0; padding: 0; box-sizing: border-box; }

  body {
    font-family: 'Inter', sans-serif;
    background: var(--light-gray);
    color: var(--navy);
    max-width: 430px;
    margin: 0 auto;
    min-height: 100vh;
    position: relative;
    overflow-x: hidden;
  }

  /* ── SCREENS ── */
  .screen { display: none; min-height: 100vh; flex-direction: column; }
  .screen.active { display: flex; }

  /* ── SPLASH ── */
  #splash {
    background: linear-gradient(160deg, var(--navy) 0%, #1a3a5c 60%, #0a4a4a 100%);
    align-items: center;
    justify-content: center;
    gap: 24px;
    padding: 40px 24px;
  }

  .splash-logo {
    font-size: 52px;
    font-weight: 800;
    color: var(--white);
    letter-spacing: -2px;
  }

  .splash-logo span { color: var(--teal); }

  .splash-tagline {
    color: rgba(255,255,255,0.7);
    font-size: 17px;
    text-align: center;
    line-height: 1.7;
  }

  .splash-badges {
    display: flex;
    gap: 10px;
    flex-wrap: wrap;
    justify-content: center;
  }

  .badge {
    background: rgba(2, 195, 154, 0.15);
    border: 1px solid rgba(2, 195, 154, 0.4);
    color: var(--teal);
    padding: 6px 14px;
    border-radius: 20px;
    font-size: 13px;
    font-weight: 500;
  }

  .btn-primary {
    background: var(--teal);
    color: var(--navy);
    font-family: 'Inter', sans-serif;
    font-size: 17px;
    font-weight: 700;
    padding: 16px 48px;
    border-radius: 14px;
    border: none;
    cursor: pointer;
    width: 100%;
    max-width: 320px;
    transition: all 0.2s;
    margin-top: 8px;
  }

  .btn-primary:hover { background: #01a882; transform: translateY(-1px); }

  .btn-secondary {
    background: transparent;
    color: rgba(255,255,255,0.6);
    font-family: 'Inter', sans-serif;
    font-size: 15px;
    border: none;
    cursor: pointer;
    padding: 8px;
  }

  /* ── ONBOARDING ── */
  #onboarding {
    background: var(--white);
  }

  .onboard-header {
    background: linear-gradient(135deg, var(--navy), #1a3a5c);
    padding: 50px 24px 30px;
    color: white;
  }

  .progress-bar {
    height: 4px;
    background: rgba(255,255,255,0.2);
    border-radius: 2px;
    margin-bottom: 24px;
    overflow: hidden;
  }

  .progress-fill {
    height: 100%;
    background: var(--teal);
    border-radius: 2px;
    transition: width 0.4s ease;
  }

  .step-label {
    font-size: 12px;
    color: rgba(255,255,255,0.5);
    margin-bottom: 8px;
    letter-spacing: 1px;
  }

  .step-question {
    font-size: 22px;
    font-weight: 700;
    line-height: 1.4;
  }

  .onboard-body { padding: 28px 20px; flex: 1; }

  .options-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 12px;
    margin-bottom: 24px;
  }

  .option-card {
    border: 2px solid var(--border);
    border-radius: 14px;
    padding: 16px 12px;
    text-align: center;
    cursor: pointer;
    transition: all 0.2s;
    background: var(--white);
  }

  .option-card:hover { border-color: var(--teal); background: var(--light); }
  .option-card.selected { border-color: var(--teal); background: #e6faf5; }

  .option-icon { font-size: 28px; margin-bottom: 8px; }
  .option-label { font-size: 14px; font-weight: 600; color: var(--navy); }
  .option-desc { font-size: 12px; color: var(--gray); margin-top: 3px; }

  .options-list { display: flex; flex-direction: column; gap: 10px; }

  .option-row {
    border: 2px solid var(--border);
    border-radius: 12px;
    padding: 14px 16px;
    cursor: pointer;
    transition: all 0.2s;
    display: flex;
    align-items: center;
    gap: 12px;
    background: var(--white);
  }

  .option-row:hover { border-color: var(--teal); }
  .option-row.selected { border-color: var(--teal); background: #e6faf5; }
  .option-row-icon { font-size: 22px; }
  .option-row-text { flex: 1; }
  .option-row-label { font-size: 15px; font-weight: 600; }
  .option-row-sub { font-size: 12px; color: var(--gray); }

  .slider-container { padding: 10px 0 20px; }
  .amount-display {
    font-size: 36px;
    font-weight: 800;
    color: var(--teal);
    text-align: center;
    margin-bottom: 8px;
  }
  .amount-label { text-align: center; color: var(--gray); font-size: 14px; margin-bottom: 20px; }

  input[type=range] {
    width: 100%;
    height: 6px;
    border-radius: 3px;
    background: linear-gradient(to left, var(--teal) 30%, var(--border) 30%);
    outline: none;
    -webkit-appearance: none;
  }
  input[type=range]::-webkit-slider-thumb {
    -webkit-appearance: none;
    width: 24px; height: 24px;
    background: var(--teal);
    border-radius: 50%;
    cursor: pointer;
    border: 3px solid white;
    box-shadow: 0 2px 8px rgba(2,195,154,0.4);
  }

  /* ── DASHBOARD ── */
  #dashboard { background: var(--light-gray); }

  .top-bar {
    background: linear-gradient(135deg, var(--navy) 0%, #1a3a5c 100%);
    padding: 50px 20px 70px;
    position: relative;
  }

  .top-bar-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 20px;
  }

  .greeting { color: rgba(255,255,255,0.6); font-size: 14px; }
  .user-name { color: white; font-size: 20px; font-weight: 700; margin-top: 2px; }

  .notif-btn {
    width: 40px; height: 40px;
    background: rgba(255,255,255,0.1);
    border-radius: 12px;
    border: none;
    cursor: pointer;
    font-size: 18px;
    display: flex; align-items: center; justify-content: center;
  }

  .portfolio-card {
    background: rgba(255,255,255,0.08);
    border: 1px solid rgba(255,255,255,0.12);
    border-radius: 20px;
    padding: 20px;
    color: white;
  }

  .portfolio-label { font-size: 13px; color: rgba(255,255,255,0.5); margin-bottom: 6px; }
  .portfolio-amount { font-size: 36px; font-weight: 800; letter-spacing: -1px; }
  .portfolio-change {
    display: flex; gap: 16px; margin-top: 12px; flex-wrap: wrap;
  }
  .change-item { font-size: 13px; }
  .change-green { color: var(--teal); }
  .change-gray { color: rgba(255,255,255,0.5); }

  .sharia-badge {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    background: rgba(2,195,154,0.15);
    border: 1px solid rgba(2,195,154,0.3);
    color: var(--teal);
    padding: 6px 12px;
    border-radius: 20px;
    font-size: 12px;
    margin-top: 12px;
  }

  .content-area {
    padding: 0 16px 100px;
    margin-top: -30px;
  }

  .quick-actions {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 8px;
    margin-bottom: 20px;
  }

  .quick-btn {
    background: var(--white);
    border-radius: 14px;
    padding: 14px 8px;
    text-align: center;
    cursor: pointer;
    border: none;
    transition: all 0.2s;
    box-shadow: 0 2px 8px rgba(0,0,0,0.06);
  }

  .quick-btn:hover { transform: translateY(-2px); box-shadow: 0 6px 16px rgba(0,0,0,0.1); }
  .quick-btn-icon { font-size: 22px; margin-bottom: 6px; }
  .quick-btn-label { font-size: 11px; color: var(--gray); font-weight: 500; }

  .section-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 12px;
    margin-top: 20px;
  }

  .section-title { font-size: 16px; font-weight: 700; }
  .see-all { font-size: 13px; color: var(--teal); cursor: pointer; border: none; background: none; font-family: 'Inter', sans-serif; }

  /* Alert Card */
  .alert-card {
    background: linear-gradient(135deg, #e6faf5, #f0fffc);
    border: 1px solid rgba(2,195,154,0.3);
    border-radius: 16px;
    padding: 16px;
    margin-bottom: 16px;
    cursor: pointer;
  }

  .alert-card-header { display: flex; align-items: center; gap: 10px; margin-bottom: 8px; }
  .alert-icon { font-size: 20px; }
  .alert-title { font-size: 14px; font-weight: 700; color: var(--navy); }
  .alert-time { font-size: 11px; color: var(--gray); margin-right: auto; }
  .alert-body { font-size: 13px; color: var(--gray); line-height: 1.6; }

  /* Investment Card */
  .invest-card {
    background: var(--white);
    border-radius: 16px;
    padding: 14px 16px;
    margin-bottom: 10px;
    display: flex;
    align-items: center;
    gap: 12px;
    cursor: pointer;
    box-shadow: 0 2px 8px rgba(0,0,0,0.05);
    transition: all 0.2s;
  }

  .invest-card:hover { transform: translateY(-1px); box-shadow: 0 6px 16px rgba(0,0,0,0.08); }

  .invest-avatar {
    width: 44px; height: 44px;
    border-radius: 12px;
    background: var(--navy);
    display: flex; align-items: center; justify-content: center;
    font-size: 16px; font-weight: 700; color: white;
    flex-shrink: 0;
  }

  .invest-info { flex: 1; }
  .invest-name { font-size: 15px; font-weight: 700; }
  .invest-type { font-size: 12px; color: var(--gray); }
  .halal-tag {
    font-size: 10px;
    background: #e6faf5;
    color: var(--teal);
    padding: 2px 7px;
    border-radius: 6px;
    font-weight: 600;
  }

  .invest-amount { text-align: left; }
  .invest-value { font-size: 15px; font-weight: 700; }
  .invest-change-pos { font-size: 12px; color: var(--green); }
  .invest-change-neg { font-size: 12px; color: var(--red); }

  /* ── BOTTOM NAV ── */
  .bottom-nav {
    position: fixed;
    bottom: 0;
    left: 50%;
    transform: translateX(-50%);
    width: 100%;
    max-width: 430px;
    background: var(--white);
    border-top: 1px solid var(--border);
    display: flex;
    padding: 10px 0 20px;
    z-index: 100;
  }

  .nav-item {
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 4px;
    cursor: pointer;
    padding: 6px 0;
    border: none;
    background: none;
    font-family: 'Inter', sans-serif;
  }

  .nav-icon { font-size: 22px; }
  .nav-label { font-size: 10px; color: var(--gray); }
  .nav-item.active .nav-label { color: var(--teal); }
  .nav-item.active .nav-icon { filter: none; }

  .nav-ai-btn {
    width: 52px; height: 52px;
    background: linear-gradient(135deg, var(--teal), var(--teal2));
    border-radius: 16px;
    display: flex; align-items: center; justify-content: center;
    font-size: 24px;
    margin-top: -16px;
    box-shadow: 0 4px 16px rgba(2,195,154,0.4);
    border: none;
    cursor: pointer;
  }

  /* ── AI CHAT ── */
  #chat-screen {
    background: var(--light-gray);
    display: none;
    flex-direction: column;
    height: 100vh;
  }

  #chat-screen.active { display: flex; }

  .chat-header {
    background: linear-gradient(135deg, var(--navy), #1a3a5c);
    padding: 50px 20px 16px;
    display: flex;
    align-items: center;
    gap: 12px;
    color: white;
  }

  .back-btn {
    background: rgba(255,255,255,0.1);
    border: none;
    width: 36px; height: 36px;
    border-radius: 10px;
    font-size: 18px;
    cursor: pointer;
    display: flex; align-items: center; justify-content: center;
  }

  .chat-ai-avatar {
    width: 40px; height: 40px;
    background: var(--teal);
    border-radius: 12px;
    display: flex; align-items: center; justify-content: center;
    font-size: 20px;
  }

  .chat-ai-info { flex: 1; }
  .chat-ai-name { font-size: 16px; font-weight: 700; }
  .chat-ai-status { font-size: 12px; color: rgba(255,255,255,0.5); }

  .chat-messages {
    flex: 1;
    overflow-y: auto;
    padding: 16px;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .msg {
    max-width: 80%;
    padding: 12px 16px;
    border-radius: 16px;
    font-size: 14px;
    line-height: 1.6;
  }

  .msg-ai {
    background: var(--white);
    color: var(--navy);
    align-self: flex-end;
    border-bottom-right-radius: 4px;
    box-shadow: 0 2px 8px rgba(0,0,0,0.06);
  }

  .msg-user {
    background: var(--teal);
    color: white;
    align-self: flex-start;
    border-bottom-left-radius: 4px;
  }

  .msg-time {
    font-size: 10px;
    color: var(--gray);
    margin-top: 4px;
    text-align: center;
  }

  .suggestions {
    display: flex;
    gap: 8px;
    padding: 0 16px 8px;
    overflow-x: auto;
    scrollbar-width: none;
  }

  .suggestion-chip {
    background: var(--white);
    border: 1px solid var(--border);
    color: var(--navy);
    padding: 8px 14px;
    border-radius: 20px;
    font-size: 13px;
    white-space: nowrap;
    cursor: pointer;
    font-family: 'Inter', sans-serif;
    transition: all 0.2s;
  }

  .suggestion-chip:hover { border-color: var(--teal); color: var(--teal); }

  .chat-input-area {
    padding: 12px 16px 30px;
    background: var(--white);
    border-top: 1px solid var(--border);
    display: flex;
    gap: 10px;
    align-items: flex-end;
  }

  .chat-input {
    flex: 1;
    border: 2px solid var(--border);
    border-radius: 14px;
    padding: 12px 16px;
    font-family: 'Inter', sans-serif;
    font-size: 15px;
    outline: none;
    resize: none;
    max-height: 100px;
    direction: rtl;
    transition: border-color 0.2s;
  }

  .chat-input:focus { border-color: var(--teal); }

  .send-btn {
    width: 46px; height: 46px;
    background: var(--teal);
    border: none;
    border-radius: 12px;
    cursor: pointer;
    font-size: 20px;
    display: flex; align-items: center; justify-content: center;
    flex-shrink: 0;
    transition: all 0.2s;
  }

  .send-btn:hover { background: #01a882; }

  .typing-indicator {
    display: flex;
    gap: 4px;
    align-items: center;
    padding: 12px 16px;
    background: var(--white);
    border-radius: 16px;
    align-self: flex-end;
    width: fit-content;
  }

  .typing-dot {
    width: 8px; height: 8px;
    background: var(--teal);
    border-radius: 50%;
    animation: typing 1.2s infinite;
  }

  .typing-dot:nth-child(2) { animation-delay: 0.2s; }
  .typing-dot:nth-child(3) { animation-delay: 0.4s; }

  @keyframes typing {
    0%, 60%, 100% { transform: translateY(0); opacity: 0.4; }
    30% { transform: translateY(-6px); opacity: 1; }
  }

  /* ── PAPER TRADING ── */
  #trading-screen {
    background: var(--light-gray);
    display: none;
    flex-direction: column;
  }

  #trading-screen.active { display: flex; }

  .screen-header {
    background: linear-gradient(135deg, var(--navy), #1a3a5c);
    padding: 50px 20px 20px;
    color: white;
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .header-title { font-size: 18px; font-weight: 700; }
  .header-sub { font-size: 12px; color: rgba(255,255,255,0.5); }

  .simulator-balance {
    background: rgba(255,255,255,0.1);
    border-radius: 14px;
    padding: 14px 16px;
    margin: 0 20px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-top: 12px;
  }

  .sim-label { font-size: 12px; color: rgba(255,255,255,0.5); }
  .sim-amount { font-size: 22px; font-weight: 800; }
  .sim-badge {
    background: rgba(245,158,11,0.2);
    color: var(--gold);
    padding: 4px 10px;
    border-radius: 8px;
    font-size: 11px;
    font-weight: 600;
  }

  .trading-content { padding: 16px 16px 100px; flex: 1; overflow-y: auto; }

  .market-tabs {
    display: flex;
    gap: 8px;
    margin-bottom: 16px;
    overflow-x: auto;
    scrollbar-width: none;
    padding-bottom: 4px;
  }

  .tab-btn {
    background: var(--white);
    border: 2px solid var(--border);
    padding: 8px 16px;
    border-radius: 20px;
    font-size: 13px;
    font-weight: 600;
    cursor: pointer;
    font-family: 'Inter', sans-serif;
    color: var(--gray);
    white-space: nowrap;
    transition: all 0.2s;
  }

  .tab-btn.active {
    background: var(--teal);
    border-color: var(--teal);
    color: var(--navy);
  }

  .stock-card {
    background: var(--white);
    border-radius: 16px;
    padding: 16px;
    margin-bottom: 10px;
    box-shadow: 0 2px 8px rgba(0,0,0,0.05);
  }

  .stock-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    margin-bottom: 12px;
  }

  .stock-name { font-size: 15px; font-weight: 700; }
  .stock-ticker { font-size: 12px; color: var(--gray); }
  .stock-price { font-size: 18px; font-weight: 800; text-align: left; }
  .stock-change-pos { font-size: 13px; color: var(--green); text-align: left; }
  .stock-change-neg { font-size: 13px; color: var(--red); text-align: left; }

  .stock-actions {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 8px;
  }

  .buy-btn {
    background: var(--green);
    color: white;
    border: none;
    border-radius: 10px;
    padding: 10px;
    font-size: 14px;
    font-weight: 700;
    cursor: pointer;
    font-family: 'Inter', sans-serif;
    transition: all 0.2s;
  }

  .sell-btn {
    background: var(--light-gray);
    color: var(--red);
    border: 1px solid var(--red);
    border-radius: 10px;
    padding: 10px;
    font-size: 14px;
    font-weight: 700;
    cursor: pointer;
    font-family: 'Inter', sans-serif;
    transition: all 0.2s;
  }

  /* ── REPORT SCREEN ── */
  #report-screen {
    background: var(--light-gray);
    display: none;
    flex-direction: column;
  }

  #report-screen.active { display: flex; }

  .report-content { padding: 16px 16px 100px; overflow-y: auto; }

  .report-card {
    background: var(--white);
    border-radius: 16px;
    padding: 20px;
    margin-bottom: 12px;
    box-shadow: 0 2px 8px rgba(0,0,0,0.05);
  }

  .report-card-title {
    font-size: 15px;
    font-weight: 700;
    margin-bottom: 14px;
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .report-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 10px 0;
    border-bottom: 1px solid var(--light-gray);
  }

  .report-row:last-child { border-bottom: none; }
  .report-row-label { font-size: 13px; color: var(--gray); }
  .report-row-value { font-size: 14px; font-weight: 700; }
  .report-row-pos { color: var(--green); }
  .report-row-neg { color: var(--red); }

  .market-summary-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 10px;
  }

  .market-mini {
    background: var(--light-gray);
    border-radius: 12px;
    padding: 12px;
  }

  .market-mini-name { font-size: 12px; color: var(--gray); margin-bottom: 4px; }
  .market-mini-val { font-size: 16px; font-weight: 700; }
  .market-mini-change { font-size: 12px; }

  /* ── MODAL ── */
  .modal-overlay {
    position: fixed;
    inset: 0;
    background: rgba(0,0,0,0.5);
    z-index: 200;
    display: none;
    align-items: flex-end;
    justify-content: center;
  }

  .modal-overlay.open { display: flex; }

  .modal {
    background: var(--white);
    border-radius: 24px 24px 0 0;
    padding: 24px 20px 40px;
    width: 100%;
    max-width: 430px;
    animation: slideUp 0.3s ease;
  }

  @keyframes slideUp {
    from { transform: translateY(100%); }
    to { transform: translateY(0); }
  }

  .modal-handle {
    width: 40px; height: 4px;
    background: var(--border);
    border-radius: 2px;
    margin: 0 auto 20px;
  }

  .modal-title { font-size: 18px; font-weight: 700; margin-bottom: 16px; }

  .trade-input-group { margin-bottom: 16px; }
  .trade-label { font-size: 13px; color: var(--gray); margin-bottom: 6px; }

  .trade-input {
    width: 100%;
    border: 2px solid var(--border);
