          </div>
        </div>
      </div>
      <div class="stock-actions">
        <button class="buy-btn" onclick="openTradeModal('${s.id}', true)">${t('buy_btn')}</button>
        <button class="sell-btn" onclick="openTradeModal('${s.id}', false)">${t('sell_btn')}</button>
      </div>
    </div>
  `).join('');
}

function filterStocks(type, btn) {
  currentTab = type;
  document.querySelectorAll('.tab-btn').forEach(b => b.classList.remove('active'));
  btn.classList.add('active');
  renderStocks(type);
}

function openTradeModal(stockId, buying) {
  currentStock = stocks.find(s => s.id === stockId);
  isBuying = buying;
  document.getElementById('modal-title').textContent =
    (buying ? t('buy_prefix') : t('sell_prefix')) + currentStock.name;
  document.getElementById('confirm-trade-btn').textContent =
    buying ? t('buy_confirm') : t('sell_confirm');
  document.getElementById('confirm-trade-btn').style.background =
    buying ? 'var(--green)' : 'var(--red)';
  document.getElementById('trade-qty').value = 1;
  updateTradeSummary();
  document.getElementById('trade-modal').classList.add('open');
}

function updateTradeSummary() {
  if (!currentStock) return;
  const qty = parseInt(document.getElementById('trade-qty').value) || 1;
  const total = qty * currentStock.price;
  document.getElementById('modal-price').textContent = (LANG==='ar' ? currentStock.price.toLocaleString('ar')+' ر.ق' : 'QR ' + currentStock.price.toLocaleString('en'));
  document.getElementById('modal-total').textContent = (LANG==='ar' ? total.toLocaleString('ar')+' ر.ق' : 'QR ' + total.toLocaleString('en'));
  document.getElementById('modal-balance').textContent = (LANG==='ar' ? simBalance.toLocaleString('ar')+' ر.ق' : 'QR ' + simBalance.toLocaleString('en'));
}

function confirmTrade() {
  const qty = parseInt(document.getElementById('trade-qty').value) || 1;
  const total = qty * currentStock.price;

  if (isBuying) {
    if (total > simBalance) { showToast(t('toast_nobalance')); return; }
    simBalance -= total;
    simHoldings[currentStock.id] = (simHoldings[currentStock.id] || 0) + qty;
    simPnl += total * (currentStock.change / 100);
    showToast(`${t('bought')} ${qty} ${t('of')} ${currentStock.name}`);
  } else {
    if (!simHoldings[currentStock.id] || simHoldings[currentStock.id] < qty) {
      showToast(t('toast_noholding')); return;
    }
    simBalance += total;
    simHoldings[currentStock.id] -= qty;
    showToast(`${t('sold')} ${qty} ${t('of')} ${currentStock.name}`);
  }

  document.getElementById('sim-balance').textContent = (LANG==='ar' ? simBalance.toLocaleString('ar')+' ر.ق' : 'QR ' + simBalance.toLocaleString('en'));
  document.getElementById('sim-pnl').textContent =
    (simPnl >= 0 ? '+' : '') + (LANG==='ar' ? Math.round(simPnl).toLocaleString('ar')+' ر.ق' : ' QR ' + Math.round(simPnl).toLocaleString('en'));
  document.getElementById('sim-pnl').style.color = simPnl >= 0 ? 'var(--teal)' : 'var(--red)';

  closeModal();
}

function closeModal() {
  document.querySelectorAll('.modal-overlay').forEach(m => m.classList.remove('open'));
}

function showPurificationModal() {
  document.getElementById('purif-modal').classList.add('open');
}

