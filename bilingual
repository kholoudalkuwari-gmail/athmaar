function selectOption(i) {
  selections[currentStep] = i;
  renderStep();
}

function updateSlider(val) {
  selections[currentStep] = parseInt(val);
  document.querySelector('.amount-display').textContent = (LANG==='ar' ? parseInt(val).toLocaleString('ar')+' ر.ق' : 'QR ' + parseInt(val).toLocaleString('en'));
}

function selectAmount(val) {
  selections[currentStep] = val;
  renderStep();
}

function nextStep() {
  if (currentStep < onboardSteps.length - 1) {
    currentStep++;
    renderStep();
  } else {
    showScreen('dashboard');
    showToast(t('toast_created'));
  }
}

function skipOnboarding() { showScreen('dashboard'); }

