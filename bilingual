  } else if (step.type === 'slider') {
    const val = selections[currentStep] || step.default;
    body.innerHTML = `
      <div class="slider-container">
        <div class="amount-display">${LANG==='ar' ? val.toLocaleString('ar')+' ر.ق' : 'QR '+val.toLocaleString('en')}</div>
